# NopeBot configuration
SERVER_PORT=8080
MY_SERVER_API_KEY=
JINA_API_KEYS=
TAVILY_API_KEYS=

# Owner-only WhatsApp Web UI authentication (/api/wa/*)
# WEB_PASSWORD: optional extra owner password required alongside 6-digit WhatsApp verification
# WEB_OTP_REQUIRED: defaults to true (6-digit code sent to Owner's WhatsApp or server console)
WEB_PASSWORD=
WEB_OTP_REQUIRED=true

# Optional ngrok configuration.
# Keep the token out of source control. Set these in the runtime environment/.env.
NGROK_ENABLED=false
NGROK_DOMAIN=
NGROK_AUTHTOKEN=
